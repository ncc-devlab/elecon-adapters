{
  "name": "@elecon/tools",
  "version": "0.1.0",
  "private": true,
  "description": "Source-package building/signing, domain contract generation and synthetic-data scanning.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "elecon-codegen": "src/codegen/index.ts",
    "elecon-scan": "src/scanner/index.ts"
  },
  "scripts": {
    "codegen": "tsx src/codegen/index.ts",
    "scan": "tsx src/scanner/index.ts",
    "scripts:check-sdk": "tsc -p ../contract/script-sdk/tsconfig.json",
    "scripts:package": "tsx src/script/package.ts",
    "scripts:sign": "node --import tsx src/script/sign.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "core-js-pure": "3.49.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
