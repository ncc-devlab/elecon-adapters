{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.signed-script-payload",
  "title": "Signed source payload (ADR-127)",
  "description": "Exact UTF-8 bytes hashed by SHA-256 for the /3 signed message; at most 1 MiB.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest",
    "source",
    "publicKey"
  ],
  "properties": {
    "manifest": {
      "$ref": "elecon.script-package#/properties/manifest",
      "description": "Complete package declaration."
    },
    "source": {
      "$ref": "elecon.script-package#/properties/source",
      "description": "Executable source covered by signature."
    },
    "publicKey": {
      "type": "object",
      "description": "Immutable publisher key, not a credential permission.",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "ed25519",
          "description": "Only Ed25519 is supported."
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "description": "Canonical Base64 encoding of the 32-byte public key."
        }
      }
    }
  }
}
