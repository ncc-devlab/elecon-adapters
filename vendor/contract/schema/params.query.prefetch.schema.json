{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.params.query.prefetch",
  "title": "前台只读补齐计划参数",
  "description": "ADR-109：SDK21完整学期查询计划；请求最多64 KiB UTF-8，身份及来源由宿主绑定。",
  "type": "object",
  "required": [
    "target",
    "seed",
    "maxQueries"
  ],
  "properties": {
    "target": {
      "type": "string",
      "description": "用户已启用的同包学期只读能力；本版本不扩展空教室1.0的三日授权。",
      "enum": [
        "schedule.week",
        "grades.list",
        "exam.list"
      ]
    },
    "seed": {
      "type": "object",
      "description": "同来源已验证的种子查询；不会混入其他包或身份的数据。",
      "additionalProperties": false,
      "required": [
        "params"
      ],
      "properties": {
        "params": {
          "type": "object",
          "description": "目标能力的完整JSON参数；由学校解释自定义filters语义，宿主不补写字段。",
          "additionalProperties": {},
          "maxProperties": 32
        },
        "data": {
          "type": "object",
          "description": "可选的同来源标准结果快照；缺失时脚本使用完整参数和自己的有界取数。",
          "additionalProperties": {}
        }
      }
    },
    "maxQueries": {
      "type": "integer",
      "description": "宿主允许的最大候选分片数；不等于执行额度，实际执行仍受20调用/80 HTTP滚动预算约束。",
      "minimum": 1,
      "maximum": 24
    },
    "cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "description": "学校上次返回的续片游标；首次省略。宿主不解析或发明其含义。"
    }
  },
  "additionalProperties": false
}
