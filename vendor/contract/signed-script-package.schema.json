{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "elecon.signed-script-package",
  "title": "签名包的 package.json (ADR-130)",
  "description": "签署原始 UTF-8 字节的摘要。条目、总量、顺序及引用由安装器额外核对。",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "publicKey", "manifest", "entry", "files"],
  "properties": {
    "format": { "const": "elecon-script/4", "description": "ZIP32 签名源码容器版本。" },
    "publicKey": {
      "type": "object", "additionalProperties": false, "required": ["algorithm", "value"],
      "description": "用于核验签名的发布公钥。",
      "properties": {
        "algorithm": { "const": "ed25519", "description": "普通 Ed25519。" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9+/]{43}=$", "description": "32 字节裸公钥的规范 Base64。" }
      }
    },
    "manifest": { "$ref": "elecon.script-package#/properties/manifest", "type": "object", "properties": {"sdkVersion": {"enum": [28, 29]}}, "description": "完整业务声明，/4 支持 SDK28 和 SDK29。" },
    "entry": { "$ref": "#/$defs/path", "description": "表中唯一 ESM 入口，原始 UTF-8 字节至多 32 MiB。" },
    "files": {
      "type": "array", "minItems": 1, "maxItems": 1024, "description": "按 ASCII 路径升序，包含入口和所有资产。",
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "$ref": "#/$defs/path", "description": "用于脚本寻址的区分大小写逻辑路径。" },
          "size": { "type": "integer", "minimum": 0, "maximum": 67108864, "description": "未压缩文件精确字节数。" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "未压缩文件原始字节的 SHA-256。" }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "maxLength": 255, "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*[/]\\.{1,2}(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$(?![\\s\\S])" }
  }
}
